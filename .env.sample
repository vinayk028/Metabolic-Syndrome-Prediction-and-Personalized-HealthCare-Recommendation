# Runtime
NODE_ENV=
SERVER_PORT=
CLIENT_PORT=
MONGO_PORT=
PREDICTION_PORT=
REPORT_PORT=

# Database (in production, put the MongoDB Atlas connection string here)
MONGODB_URI=

# Authentication (required when NODE_ENV=production; the server will not start without it)
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Internal services
PYTHON_SERVICE_URL=
REPORT_SERVICE_URL=

# Client origin(s) allowed by CORS, comma-separated, e.g. https://your-client.up.railway.app
# If unset, CLIENT_URL is used; if both are unset, only localhost is allowed.
CORS_ORIGINS=
CLIENT_URL=

# News (The Guardian Open Platform)
GUARDIAN_API_KEY=

# Chat assistant
# Supported providers: gemini or claude.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Frontend API URL
VITE_API_URL=

